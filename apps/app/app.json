{
  "expo": {
    "name": "Vase Rest",
    "slug": "vase-rest",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "vaserest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ar.vaserest.app",
      "supportsTablet": true
    },
    "android": {
      "package": "ar.vaserest.app",
      "adaptiveIcon": {
        "backgroundColor": "#177A4E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "dark": {
            "backgroundColor": "#0C0C0E"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Vase Rest usa el micrófono para dictar pedidos y órdenes.",
          "speechRecognitionPermission": "Vase Rest usa el reconocimiento de voz para entender lo que dictás."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
