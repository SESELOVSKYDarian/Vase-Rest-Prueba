PORT=3001
DATABASE_URL=postgresql://noctua:password@localhost:5432/noctua
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
JWT_SECRET=
INTERNAL_API_KEY=
INTEGRATION_ENCRYPTION_KEY=
INITIAL_ADMIN_PASSWORD=1234
INITIAL_ENCARGADO_PASSWORD=encargado123
INITIAL_MOZO_PASSWORD=mozo123
INITIAL_COCINA_PASSWORD=cocina123
INITIAL_CAJERO_PASSWORD=cajero123
INITIAL_SOPORTE_PASSWORD=soporte123
INITIAL_STOCK_PASSWORD=stock123
INITIAL_DELIVERY_PASSWORD=delivery123
INITIAL_DESARROLLADOR_PASSWORD=desarrollador123
CORS_ORIGINS=http://localhost:3000

# Facturacion ARCA
ARCA_MODO=homologacion
ARCA_CUIT=
ARCA_PUNTO_VENTA=1
ARCA_CERTIFICATE_PATH=
ARCA_PRIVATE_KEY_PATH=

# Delivery
PEDIDOSYA_API_KEY=
RAPPI_BEARER_TOKEN=
GLOVO_API_KEY=
UBEREATS_API_KEY=
DELIVERY_WEBHOOK_SECRET=

# IA: lectura de planos desde imagen (opcional). Sin clave, el resto funciona igual.
ANTHROPIC_API_KEY=
# Asistente de la carta (todo opcional: sin claves funciona con el motor propio).
# IA gratuita para entender pedidos raros y redactar recomendaciones; se usa la primera que tenga clave
# o la que indique LLM_PROVIDER (gemini | groq | anthropic). Se valida siempre contra la carta real.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Traducciones gratuitas de la carta (MyMemory): con email sube el cupo diario de 5.000 a 50.000 caracteres.
MYMEMORY_EMAIL=

# Cobro desde el QR con Mercado Pago (sin estas variables solo se ofrece transferencia).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Dirección pública del servidor (https) para el aviso de pago, y de la web para volver a la carta.
PUBLIC_API_URL=
PUBLIC_WEB_URL=

# Avisos en la pantalla bloqueada (Expo Push). El token solo hace falta si activás seguridad mejorada en tu proyecto de Expo.
EXPO_ACCESS_TOKEN=
# PUSH_ENABLED=false apaga el vigilante de avisos.
PUSH_ENABLED=true

# WhatsApp Business (Cloud API de Meta): reservas con el plano real y pedidos para llevar por chat.
# Sin estas variables el asistente igual funciona en el simulador (POST /api/whatsapp/simular, solo fuera de producción).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Carpeta de imágenes subidas (fotos de platos, planos)
UPLOADS_DIR=

# ── Seguridad ────────────────────────────────────────────────────────────────
# En producción (NODE_ENV=production) el servidor NO arranca sin esto:
#   JWT_SECRET: largo y al azar (mínimo 32 caracteres), por ejemplo `openssl rand -hex 32`
#   INITIAL_ADMIN_PASSWORD: contraseña inicial del admin (mínimo 10 caracteres)
JWT_SECRET=
INITIAL_ADMIN_PASSWORD=
# SEED_USUARIOS=false no crea ni toca usuarios al arrancar. RESET_ADMIN_PASSWORD=true vuelve a escribir la contraseña del admin.
# SEED_USUARIOS_DEMO=true crea los usuarios de ejemplo (mozo/mozo123…) también en producción: no lo hagas.
# Detrás de Cloudflare o un proxy:
#   TRUST_PROXY=1 (cantidad de proxies delante) y, solo si el servidor acepta tráfico únicamente de Cloudflare,
#   TRUST_CLOUDFLARE=true para usar la IP real del cliente (CF-Connecting-IP) en los límites de uso.
TRUST_PROXY=
TRUST_CLOUDFLARE=false
# Dominios desde los que se permite llamar a la API (separados por coma). localhost solo se acepta fuera de producción.
CORS_ORIGINS=
# Solo desarrollo: habilita POST /api/whatsapp/simular
WHATSAPP_SIMULADOR=false
