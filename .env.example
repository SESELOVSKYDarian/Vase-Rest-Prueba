# Variables que docker-compose exige. Copiá este archivo a `.env` y completá cada una:
#   openssl rand -hex 32     (para los secretos)
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
INTEGRATION_ENCRYPTION_KEY=
INITIAL_ADMIN_PASSWORD=
# Dominios que pueden llamar a la API (coma). Ej: https://app.tu-local.com
CORS_ORIGINS=
# Detrás de Cloudflare: TRUST_PROXY=1 y, si el servidor solo acepta tráfico de Cloudflare, TRUST_CLOUDFLARE=true
TRUST_PROXY=
TRUST_CLOUDFLARE=false
